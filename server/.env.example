# --- required in production ---
NODE_ENV=production
AUTH_SECRET=change-me-to-64-random-bytes
PUBLIC_URL=https://api.kinshield.example
REVENUECAT_WEBHOOK_SECRET=change-me

# Public IPs of your DNS resolvers (what parents type into their router)
RESOLVER_IPV4=203.0.113.10,203.0.113.11
RESOLVER_IPV6=

# DNS-over-TLS for Android "Private DNS": wildcard cert for *.dns.kinshield.example
DOT_DOMAIN=dns.kinshield.example
DOT_CERT_FILE=/certs/fullchain.pem
DOT_KEY_FILE=/certs/privkey.pem

# --- optional ---
API_PORT=8080
DNS_PORT=53
DOT_PORT=853
UPSTREAM_DNS=1.1.1.1,9.9.9.9
DB_FILE=/data/kinshield.db
BLOCKLIST_DIR=/data/blocklists
TRUST_PROXY=true
BRAND_NAME=KinShield
